# Stackup AI routing order. The first configured/healthy provider wins.
STACKUP_AI_PROVIDER_ORDER=GEMINI,NVIDIA,OPENAI,ANTHROPIC
# Vision can use a different priority order because model support/cost differs.
STACKUP_AI_VISION_PROVIDER_ORDER=GEMINI,OPENAI,ANTHROPIC,NVIDIA

# Secret used by the future auth/billing service to sign STACKUP AI plan entitlements.
# Anonymous users are always treated as FREE.
STACKUP_AI_ENTITLEMENT_SECRET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=
GEMINI_MODEL_DEEP=
GEMINI_VISION_MODEL=

# NVIDIA NIM / OpenAI-compatible API
NVIDIA_API_KEY=
NVIDIA_MODEL_FAST=
NVIDIA_MODEL_SMART=
NVIDIA_MODEL_DEEP=
NVIDIA_VISION_MODEL=

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_SMART=
OPENAI_MODEL_DEEP=
OPENAI_VISION_MODEL=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_SMART=
ANTHROPIC_MODEL_DEEP=
ANTHROPIC_VISION_MODEL=
