# Stackup AI routing order. The first configured/healthy provider wins.
STACKUP_AI_PROVIDER_ORDER=GEMINI,NVIDIA,OPENAI,ANTHROPIC
# Vision can use a different priority order because model support/cost differs.
STACKUP_AI_VISION_PROVIDER_ORDER=GEMINI,OPENAI,ANTHROPIC,NVIDIA

# Public URL of the Stackup AI commercial gateway.
# The browser calls this gateway; provider API keys MUST remain server-side.
# Expected route: POST /v1/spots/generate
NEXT_PUBLIC_STACKUP_AI_GATEWAY_URL=

# Legacy/public client endpoint for periodic AI-generated Player DNA spot batches.
# Used only as fallback when NEXT_PUBLIC_STACKUP_AI_GATEWAY_URL is empty.
NEXT_PUBLIC_STACKUP_SPOT_AI_ENDPOINT=

# Public read-only JSON catalog of exact, validated solver references.
# EV/frequencies are displayed only when the spot fingerprint matches exactly.
NEXT_PUBLIC_STACKUP_SOLVER_REFERENCE_URL=

# Secret used by the auth/billing service to sign STACKUP AI plan entitlements.
# Never expose this value with NEXT_PUBLIC_.
STACKUP_AI_ENTITLEMENT_SECRET=

# Billing provider identifiers. Keep secret keys server-side.
STACKUP_BILLING_PROVIDER=STRIPE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ELITE_MONTHLY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=
GEMINI_MODEL_DEEP=
GEMINI_VISION_MODEL=

# NVIDIA NIM / OpenAI-compatible API
NVIDIA_API_KEY=
NVIDIA_MODEL_FAST=
NVIDIA_MODEL_SMART=
NVIDIA_MODEL_DEEP=
NVIDIA_VISION_MODEL=

# OpenAI API
# NEVER expose this key to the browser/mobile app.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_SMART=gpt-5.6-terra
OPENAI_MODEL_DEEP=gpt-5.6-sol
OPENAI_VISION_MODEL=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_SMART=
ANTHROPIC_MODEL_DEEP=
ANTHROPIC_VISION_MODEL=
