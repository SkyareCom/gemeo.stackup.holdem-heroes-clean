# Stackup AI routing order. The first configured/healthy provider wins.
STACKUP_AI_PROVIDER_ORDER=GEMINI,NVIDIA,OPENAI,ANTHROPIC
# Vision can use a different priority order because model support/cost differs.
STACKUP_AI_VISION_PROVIDER_ORDER=GEMINI,OPENAI,ANTHROPIC,NVIDIA

# Public client endpoint for periodic AI-generated Player DNA spot batches.
# This should point to a Stackup Cloud/custom backend that calls generateStackupAiSpots().
NEXT_PUBLIC_STACKUP_SPOT_AI_ENDPOINT=

# Public read-only JSON catalog of exact, validated solver references.
# EV/frequencies are displayed only when the spot fingerprint matches exactly.
NEXT_PUBLIC_STACKUP_SOLVER_REFERENCE_URL=

# Secret used by the future auth/billing service to sign STACKUP AI plan entitlements.
# Anonymous users are always treated as FREE.
STACKUP_AI_ENTITLEMENT_SECRET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=
GEMINI_MODEL_DEEP=
GEMINI_VISION_MODEL=

# NVIDIA NIM / OpenAI-compatible API
NVIDIA_API_KEY=
NVIDIA_MODEL_FAST=
NVIDIA_MODEL_SMART=
NVIDIA_MODEL_DEEP=
NVIDIA_VISION_MODEL=

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_SMART=
OPENAI_MODEL_DEEP=
OPENAI_VISION_MODEL=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_SMART=
ANTHROPIC_MODEL_DEEP=
ANTHROPIC_VISION_MODEL=
